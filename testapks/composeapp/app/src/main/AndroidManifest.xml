<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- A signature permission an ordinary APK asks for in vain (InstallPermissionsTest: it must stay denied). -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- BluetoothActivity, BluetoothTest: getName/getAddress/enable/disable (API 31+), and their legacy permissions below. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- BleActivity, BleTest: BLE scans. Not neverForLocation: a device then delivers results only with fine location. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <application
        android:name=".ComposeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.ComposeApp">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="composeapp" />
            </intent-filter>
        </activity>
        <!-- Handles size and orientation changes itself (not recreated on rotation): StackWindowsTest. -->
        <activity android:name=".TripChooserActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />
        <!-- apksim://network: an HTTPS fetch with OkHttp and with HttpURLConnection (docs/network.md "Checks"). -->
        <activity android:name=".NetworkActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="network" />
            </intent-filter>
        </activity>
        <!-- apksim://bitmaps: framework View drawing of scaled bitmaps (GpuBitmaps). -->
        <activity android:name=".ViewBitmapsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="bitmaps" />
            </intent-filter>
        </activity>
        <!-- apksim://systembars: the system bar insets this window gets, and buttons that hide the bars. -->
        <activity android:name=".SystemBarsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="systembars" />
            </intent-filter>
        </activity>
        <!-- apksim://bluetooth: the Bluetooth adapter's state and the state broadcasts received (scripts/adb-check.py). -->
        <activity android:name=".BluetoothActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="bluetooth" />
            </intent-filter>
        </activity>
        <!-- apksim://ble: scan, connect and show a heart-rate peripheral's notifications (apksim ble heart-rate, scripts/ble-check.py). -->
        <activity android:name=".BleActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="ble" />
            </intent-filter>
        </activity>
        <!-- apksim://timer: SystemClock against the wall clock, and onUserInteraction per input path (scripts/timer-check.py). -->
        <activity android:name=".TimerActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="timer" />
            </intent-filter>
        </activity>
        <!-- apksim://popup-trace: a Trace section begun twice, and taps outside a non-focusable popup (issue 52). -->
        <activity android:name=".PopupTraceActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="popup-trace" />
            </intent-filter>
        </activity>
        <!-- apksim://cyclic-nodes: an accessibility provider that lists nodes under several parents and an ancestor as a child (issue 114). -->
        <activity android:name=".CyclicNodesActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="cyclic-nodes" />
            </intent-filter>
        </activity>
        <!-- apksim://drawer: a DrawerLayout that settles through a Scroller, no animator (issue 215). -->
        <activity android:name=".DrawerActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="drawer" />
            </intent-filter>
        </activity>
        <!-- apksim://dialogs: full-screen, modal and non-modal dialogs over an activity (issue 97). -->
        <activity android:name=".DialogsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="dialogs" />
            </intent-filter>
        </activity>
        <!-- apksim://timezone: every zone source an app reads, Joda-Time's included, and zone-change broadcasts (issue 91). -->
        <activity android:name=".TimeZoneActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="timezone" />
            </intent-filter>
        </activity>
        <!-- apksim://crash?kind=coroutine|post|worker|bare|resume|config|destroy|handled|chained: an uncaught exception (issue 104). -->
        <activity android:name=".CrashActivity" android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="crash" />
            </intent-filter>
        </activity>
        <!-- apksim://exit?kind=finish|affinity|handoff|exit|halt|kill: the app ends itself; apksim says why (issue 116). -->
        <activity android:name=".ExitActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="exit" />
            </intent-filter>
        </activity>
        <!-- apksim://install: install-time state the app's onCreate saw, and a bind to a service nothing provides. -->
        <activity android:name=".InstallStateActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="install" />
            </intent-filter>
        </activity>
        <!-- apksim://video: a 1080p60 clip looping full-screen in a TextureView. -->
        <!-- apksim://camera[?mode=compatible]: a CameraX preview and analysis of the front camera's frames. -->
        <activity android:name=".CameraActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="camera" />
            </intent-filter>
        </activity>
        <activity android:name=".VideoActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="video" />
            </intent-filter>
        </activity>
        <!-- apksim://system-sources: Wi-Fi, network, battery, volume, brightness, Bluetooth awaited in coroutines. -->
        <activity android:name=".SystemSourcesActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="system-sources" />
            </intent-filter>
        </activity>
        <service android:name=".TripSyncJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false" />
        <!-- apksim://floating: a dialog-themed activity over whatever is running (the one below stays visible). -->
        <activity android:name=".FloatingActivity" android:exported="true" android:theme="@android:style/Theme.Material.Light.Dialog">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="floating" />
            </intent-filter>
        </activity>
        <!-- apksim://stack: SecondActivity over whatever is running ("Deeper" stacks more), for stack checks. -->
        <activity android:name=".SecondActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="stack" />
            </intent-filter>
        </activity>
        <!-- For apksim's activity option (.SecondAlias): an alias keeps its own name as the intent's component (no filter: nothing else reaches it). -->
        <activity-alias android:name=".SecondAlias" android:targetActivity=".SecondActivity" android:exported="false" />
        <provider android:name=".StartupProvider" android:authorities="${applicationId}.startup" android:exported="false" />
        <service android:name=".UploadService" android:exported="false" />
        <service android:name=".NullBindingService" android:exported="false" />
        <service android:name=".BinderService" android:exported="false" />
        <service android:name=".SingletonBinderService" android:exported="false" />
        <service android:name=".StaticHandlerService" android:exported="false" />
        <receiver android:name=".ReminderReceiver" android:exported="false" />
        <!-- apksim://slot: a Settings value and a /sdcard file that the next launch of the data slot must see (issues 82, 84). -->
        <activity android:name=".SlotStateActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apksim" android:host="slot" />
            </intent-filter>
        </activity>
    </application>

</manifest>
