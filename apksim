#!/bin/bash
# Usage: apksim [--activity PKG/.Act|.Act|NAME] [--shot FILE] [--exit-after-first-frame] [--debug PORT]
#               [--instrument test.apk [-e KEY VALUE]...] app.apk
#        apksim serve [--port N] [--bind ADDR] [--token FILE] [--max N] [--idle S] [--apps DIR|FILE]...  (docs/serve.md)
#        apksim beam [--port N] [--max N] | apksim beam trust [list|allow ORIGIN|revoke ORIGIN]  (docs/beam.md)
# Runs an unmodified APK in a single host process.
set -euo pipefail
# On Linux (containers, CI) there is no window, Metal or sandbox-exec: the app runs headless and the
# container is its sandbox.
# Builtins only up to the warm-launch hand-off below: every fork costs a few ms there.
case "${OSTYPE:-}" in darwin*) OS=Darwin ;; linux*) OS=Linux ;; *) OS="$(uname -s)" ;; esac
SRC="${BASH_SOURCE[0]}"
# A link to the launcher (an installer's bin/apksim) leads to the folder it is in.
while [[ -L "$SRC" ]]; do
  LINK="$(readlink "$SRC")"
  if [[ "$LINK" == /* ]]; then SRC="$LINK"; else SRC="${SRC%/*}/$LINK"; fi
done
if [[ "$SRC" == */* ]]; then
  CDPATH= cd -- "${SRC%/*}" >/dev/null; ROOT="$PWD"; CDPATH= cd -- "$OLDPWD" >/dev/null
else
  ROOT="$PWD"
fi
# What apksim writes (the startup cache, translated classes, app data, scratch, screenshots): a source checkout keeps
# it in its own work/, an installed release (work/release, from scripts/package-release.sh) in ~/.apksim, as its own
# folder may be read-only (Homebrew). APKSIM_HOME chooses another folder.
if [[ -n "${APKSIM_HOME:-}" ]]; then STATE="$APKSIM_HOME"
elif [[ -f "$ROOT/work/release" ]]; then STATE="$HOME/.apksim"
else STATE="$ROOT/work"; fi
# Standbys are per install and state folder.
KEY="$ROOT"; [[ "$STATE" != "$ROOT/work" ]] && KEY="$ROOT:$STATE"
CLIENT="$ROOT/work/runtime/apksim-client"
case "${1:-}" in
  --version) if [[ -f "$ROOT/work/release" ]]; then echo "apksim $(< "$ROOT/work/release")"; else echo "apksim (source checkout $ROOT)"; fi; exit 0 ;;
  -h|--help)
    cat <<'EOF'
Usage: apksim [options] APP.apk
       apksim serve [--port N] [--bind ADDR] [--token FILE] [--max N] [--idle S] [--apps DIR|FILE]...
       apksim beam [--port N] [--max N]    run browser sessions' apps on this Mac (docs/beam.md)
       apksim --instrument TEST.apk [-e KEY VALUE]... APP.apk
       apksim --version | --train | --stop-standbys

Common options (each is listed with its values in the README, "Devices and launch options"):
  --device NAME|WxH[@density]   phone, foldable, tablet, desktop, tv, or a size in dp (density 0.75-4)
  --activity PKG/.Act           start this activity instead of the launcher one
  --appearance dark|light, --locale xx-YY, --timezone ZONE, --font-scale N
  --control PORT|auto           command channel (scripts/drive.py, scripts/ctl.py)
  --adb PORT|auto               adb device (adb connect localhost:PORT)
  --headless, --window front|nofocus|background|minimized|hidden
  --network record|replay FILE, --network-profile offline|3g|lossy
  --no-network, --no-sandbox, --fresh, --debug PORT, --jvm OPTION
  --skip-library NAME           the app's System.loadLibrary(NAME) throws UnsatisfiedLinkError (repeatable)
  --move-shared-data            macOS: load 4 KB-aligned libraries with data on a code page (experimental)

Full reference: https://github.com/aglose/apksim#devices-and-launch-options
EOF
    exit 0 ;;
  # Builds the startup cache now, in the foreground (an installed release otherwise builds it in the background on
  # its first launch).
  --train) shift; exec "$ROOT/scripts/train.sh" "$@" ;;
  # APKs in a browser tab (docs/serve.md): an HTTP server that starts an instance per tab. Runs on a plain JVM below.
  serve) SERVE=1; shift ;;
  # A browser session's app run on this Mac (docs/beam.md): serve in its loopback-only agent mode, same JVM below.
  beam) SERVE=1; shift; set -- --beam "$@" ;;
esac
# Warm launches: a standby is a JVM that has already booted the framework and waits for an APK (Standby.java). It
# is per apksim folder and sandbox flags. Instances start one in the background after their first
# frame (--spawn-standby); a launch hands its APK and terminal to it (apksim-client), or launches cold if there is
# none. APKSIM_STANDBY=0 turns this off.
if [[ "${1:-}" == --spawn-standby ]]; then
  FLAGS="${2:-}"
  SOCK="$("$CLIENT" sock "$KEY" "$FLAGS")"
  [[ -S "$SOCK" ]] && exit 0
  if [[ -f "$SOCK.pid" ]] && kill -0 "$(cat "$SOCK.pid" 2>/dev/null)" 2>/dev/null; then exit 0; fi
  rm -f "$SOCK.pid"
  ARGS=(--standby "$SOCK")
  [[ "$FLAGS" == *n* ]] && ARGS+=(--no-network)
  [[ "$FLAGS" == *s* ]] && ARGS+=(--no-sandbox)
  # k: no core dumps (apksim serve): a flag of the standby's name, since its JVM fixes it at its start.
  if [[ "$FLAGS" == *k* ]]; then export APKSIM_NO_CORE=1; else unset APKSIM_NO_CORE; fi
  exec "$CLIENT" detach "$SOCK.log" "$ROOT/apksim" "${ARGS[@]}"
fi
if [[ "${1:-}" == --stop-standbys ]]; then
  # This folder's standbys (they also quit after an hour unused, or when work/apksim.jar or work/app.aot change).
  for FLAGS in "" n s ns k nk sk nsk; do
    SOCK="$("$CLIENT" sock "$KEY" "$FLAGS")"
    [[ -f "$SOCK.pid" ]] && kill "$(cat "$SOCK.pid")" 2>/dev/null && echo "stopped standby $(cat "$SOCK.pid")"
    rm -f "$SOCK" "$SOCK.pid"
  done
  exit 0
fi
ORIG=("$@")
EXTRA=()
STANDBY_SOCK=""
if [[ "${1:-}" == --standby ]]; then
  STANDBY_SOCK="$2"; shift 2
  set -- "$@" /dev/null  # no APK yet
  # Claim the slot: exec below keeps this PID for the JVM.
  if ! (set -C; echo $$ > "$STANDBY_SOCK.pid") 2>/dev/null; then exit 0; fi
fi
while [[ -z "${SERVE:-}" && $# -gt 1 ]]; do
  case "$1" in
    # The activity to start instead of the first MAIN/LAUNCHER one: PKG/.Act, .Act, a full or simple class name;
    # any activity in the manifest, exported or not (AppInfo).
    --activity) EXTRA+=("-Dapksim.activity=$2"); shift 2 ;;
    --shot) EXTRA+=("-Dapksim.screenshot=$2"); shift 2 ;;
    --exit-after-first-frame) EXTRA+=("-Dapksim.exitAfterFirstFrame=true"); shift ;;
    --control) EXTRA+=("-Dapksim.control=$2"); shift 2 ;;
    --control-bind) EXTRA+=("-Dapksim.controlBind=$2"); shift 2 ;;
    --adb) EXTRA+=("-Dapksim.adb=$2"); shift 2 ;;
    --jvm) EXTRA+=("$2"); shift 2 ;;
    # A JDWP port for IntelliJ/Android Studio "Remote JVM Debug" (attach any time; the app does not wait), and app
    # classes translated with line numbers and local variables (their own class cache).
    --debug) EXTRA+=("-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=$2" "-Dapksim.debugInfo=true"); shift 2 ;;
    --device) EXTRA+=("-Dapksim.device=$2"); shift 2 ;;
    # A device profile (scripts/device-profile.py): display, Build fields, features and settings of a real device,
    # expanded into --device, --build, --feature and --setting options (later options on the command line win).
    --device-profile)
      [[ -r "$2" ]] || { echo "--device-profile: cannot read $2" >&2; exit 2; }
      PROFILE_ARGS=(); PSIZE=""; PDPI=""; PFILE="$2"
      while IFS= read -r PLINE || [[ -n "$PLINE" ]]; do
        [[ -z "$PLINE" || "$PLINE" == \#* || "$PLINE" != *=* ]] && continue
        PK="${PLINE%%=*}"; PV="${PLINE#*=}"
        case "$PK" in
          display.size) PSIZE="$PV" ;;
          display.density) PDPI="$PV" ;;
          build.*) PROFILE_ARGS+=(--build "${PK#build.}=$PV") ;;
          feature.*) if [[ "$PV" == false ]]; then PROFILE_ARGS+=(--feature "${PK#feature.}=false"); else PROFILE_ARGS+=(--feature "${PK#feature.}"); fi ;;
          setting.*) PROFILE_ARGS+=(--setting "${PK#setting.}=$PV") ;;
        esac
      done < "$PFILE"
      if [[ -n "$PSIZE" && -n "$PDPI" ]]; then PROFILE_ARGS+=(--device "${PSIZE}px@${PDPI}dpi")
      elif [[ -n "$PSIZE$PDPI" ]]; then echo "--device-profile: display.size and display.density go together" >&2; exit 2; fi
      shift 2; set -- "${PROFILE_ARGS[@]}" "$@" ;;
    --appearance) EXTRA+=("-Dapksim.appearance=$2"); shift 2 ;;
    --locale) EXTRA+=("-Dapksim.locale=$2"); shift 2 ;;
    --timezone) EXTRA+=("-Dapksim.timezone=$2"); shift 2 ;;
    # The wall clock the app sees starts at this instant (ISO 8601 or epoch ms) and runs on from it.
    --clock) EXTRA+=("-Dapksim.clock=$2"); shift 2 ;;
    # Screenshot tests (docs/snapshots.md): CPU-only drawing and carets that do not blink, for the same pixels each run.
    --snapshot) EXTRA+=("-Dapksim.snapshot=true"); shift ;;
    # Made here, as --bundles is: under the sandbox only the folder itself is writable, not a missing parent.
    --test-outputs) mkdir -p "$2" && TEST_OUTPUTS="$(cd "$2" && pwd)"; EXTRA+=("-Dapksim.testOutputs=$TEST_OUTPUTS"); shift 2 ;;
    # Test runs: a movie of each test (TestRecorder), kept for failed tests (--record failed) or all. The folder is
    # made here, as --bundles' is; --record-size caps the frame size, --record-fps the frame rate.
    --record) [[ "$2" == failed || "$2" == all ]] || { echo "--record takes failed or all" >&2; exit 2; }
      RECORD_MODE="$2"; EXTRA+=("-Dapksim.record=$2"); shift 2 ;;
    --record-dir) mkdir -p "$2" && RECORD_DIR="$(cd "$2" && pwd)"; EXTRA+=("-Dapksim.record.dir=$RECORD_DIR"); shift 2 ;;
    --record-size) EXTRA+=("-Dapksim.record.size=$2"); shift 2 ;;
    --record-fps) EXTRA+=("-Dapksim.record.fps=$2"); shift 2 ;;
    --font-scale) EXTRA+=("-Dapksim.fontScale=$2"); shift 2 ;;
    --permissions) EXTRA+=("-Dapksim.permissions=$2"); shift 2 ;;
    # Device identity (DeviceIdentity.java): Build.getSerial(), a system feature (repeatable; NAME=false removes one),
    # any Build or Build.VERSION field (repeatable: MODEL=..., VERSION.RELEASE=...).
    --serial) EXTRA+=("-Dapksim.serial=$2"); shift 2 ;;
    --feature) FEATURES="${FEATURES:+$FEATURES,}$2"; shift 2 ;;
    # A native library the app's System.loadLibrary must not load (repeatable): it throws UnsatisfiedLinkError as for
    # one the APK lacks, which an SDK with an optional native part catches (ElfLoader.java).
    --skip-library) SKIP_LIBS="${SKIP_LIBS:+$SKIP_LIBS,}$2"; shift 2 ;;
    # macOS: load a 4 KB-aligned library whose writable data shares a 16 KB page with its code by moving that data
    # (experimental; refused by default, native/elfloader.c plan_data_move).
    --move-shared-data) EXTRA+=("-Dapksim.moveSharedData=true"); shift ;;
    # A Settings value set before the app starts (repeatable), as `adb shell settings put` would (SlotDevice.java).
    --setting)
      [[ "$2" =~ ^(global|secure|system):[^=]+= ]] || { echo "--setting takes global|secure|system:KEY=VALUE" >&2; exit 2; }
      EXTRA+=("-Dapksim.setting.${SETTING_N:-0}=$2"); SETTING_N=$((${SETTING_N:-0} + 1)); shift 2 ;;
    --build)
      [[ "$2" == ?*=* ]] || { echo "--build takes FIELD=VALUE" >&2; exit 2; }
      EXTRA+=("-Dapksim.build.${2%%=*}=${2#*=}"); shift 2 ;;
    # Mockito's mock maker for the tests: auto (ART makers become JVM ones), keep, subclass, inline, or a maker name.
    --mock-maker) EXTRA+=("-Dapksim.mockMaker=$2"); shift 2 ;;
    --biometrics) [[ "$2" == enrolled ]] && EXTRA+=("-Dapksim.biometricsEnrolled=true"); shift 2 ;;
    # The Bluetooth adapter at launch: on (default, as an emulator boots) or off (Bluetooth.java).
    --bluetooth) EXTRA+=("-Dapksim.bluetooth=$2"); shift 2 ;;
    --soft-keyboard) EXTRA+=("-Dapksim.softKeyboard=true"); shift ;;
    # System bars, overriding the --device preset (phone/foldable/tablet: both; desktop/TV: none).
    --status-bar) EXTRA+=("-Dapksim.statusBar=$2"); shift 2 ;;
    --nav-bar) EXTRA+=("-Dapksim.navBar=$2"); shift 2 ;;
    # What an instance spends on things a journey may not need (Features.java): a frame rate cap, video decoding
    # (blank: players play, nothing decoded or drawn; off: no decoders listed), sound, animations, offscreen GLES.
    --max-fps)
      [[ "$2" =~ ^[0-9]+$ ]] && (( 10#$2 >= 1 && 10#$2 <= 120 )) || { echo "--max-fps takes a whole number, 1-120" >&2; exit 2; }
      EXTRA+=("-Dapksim.maxFps=$2"); shift 2 ;;
    --video)
      [[ "$2" == on || "$2" == blank || "$2" == off ]] || { echo "--video takes on, blank or off" >&2; exit 2; }
      EXTRA+=("-Dapksim.video=$2"); shift 2 ;;
    --audio)
      [[ "$2" == on || "$2" == mute || "$2" == off ]] || { echo "--audio takes on, mute or off" >&2; exit 2; }
      EXTRA+=("-Dapksim.audio=$2"); shift 2 ;;
    --anim-scale)
      [[ "$2" =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "--anim-scale takes a number: 0 off, 1 normal, 10 slow" >&2; exit 2; }
      EXTRA+=("-Dapksim.animScale=$2"); shift 2 ;;
    --gles)
      [[ "$2" == on || "$2" == off ]] || { echo "--gles takes on or off" >&2; exit 2; }
      EXTRA+=("-Dapksim.gles=$([[ "$2" == on ]] && echo true || echo false)"); shift 2 ;;
    --window-x) EXTRA+=("-Dapksim.windowX=$2"); shift 2 ;;
    --headless) EXTRA+=("-Dapksim.headless=true"); shift ;;
    # How the Mac window shows itself: front (default), nofocus, background, minimized, hidden. APKSIM_WINDOW sets a
    # default for every launch.
    --window) WINDOW_MODE="$2"; shift 2 ;;
    # Erase the app's data first, so it starts as just installed (reproducible runs).
    --fresh) EXTRA+=("-Dapksim.fresh=true"); shift ;;
    # Never fill a sign-in form from work/autofill (apksim serve's instances: other people use them).
    --no-autofill) EXTRA+=("-Dapksim.noAutofill=true"); shift ;;
    # App data in slots NAME-0, NAME-1... instead of default, instance-N (apksim serve: never the owner's own data).
    --data-slots) EXTRA+=("-Dapksim.dataSlots=$2"); shift 2 ;;
    # Run a test APK (androidTest build) against the app, as `am instrument -w -r [-e KEY VALUE]...` would.
    --instrument) EXTRA+=("-Dapksim.instrument=$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"); TEST_RUN=1; shift 2 ;;
    -e) EXTRA+=("-Dapksim.instrument.$2=$3"); shift 3 ;;
    # In a test run, the simulated clock follows real time instead of skipping idle time (timed UI as on a device).
    --realtime-clock) EXTRA+=("-Dapksim.realtimeClock=true"); shift ;;
    # Failure bundles (test runs): what each failing test left, in DIR/<class>/<method>-<hash>/ (docs/plan.md phase 5).
    --bundles) mkdir -p "$2" && BUNDLES="$(cd "$2" && pwd)"; EXTRA+=("-Dapksim.bundles=$BUNDLES"); shift 2 ;;
    --bundles-on) EXTRA+=("-Dapksim.bundles.on=$2"); shift 2 ;;
    --bundles-max) EXTRA+=("-Dapksim.bundles.max=$2"); shift 2 ;;
    --bundles-redact) EXTRA+=("-Dapksim.bundles.redact.${REDACT_N:-0}=$2"); REDACT_N=$((${REDACT_N:-0} + 1)); shift 2 ;;
    --start-activities) EXTRA+=("-Dapksim.startActivities=true"); shift ;;
    --no-network) NO_NET=1; shift ;;
    # Record and replay the app's HTTP(S), and network conditions (docs/network.md).
    --network)
      [[ "$2" == record || "$2" == replay ]] || { echo "--network takes record FILE or replay FILE" >&2; exit 2; }
      # The folder is resolved on its own: a missing one must stop here, not become "/" (and a sandbox rule for it).
      NET_DIR="$(cd "$(dirname "$3")" 2>/dev/null && pwd)" || { echo "no folder $(dirname "$3") for $3" >&2; exit 2; }
      NET_FILE="$NET_DIR/$(basename "$3")"
      [[ "$2" == replay && ! -f "$NET_FILE" ]] && { echo "no recording at $3" >&2; exit 2; }
      # Recording, the sandbox lets the app write the recording and its temporary file, nothing else beside them.
      if [[ "$2" == record ]]; then
        [[ "$NET_FILE" == *'"'* || "$NET_FILE" == *'\'* ]] && { echo "a recording path cannot hold \" or \\" >&2; exit 2; }
        NET_RECORD_FILE="$NET_FILE"
      fi
      EXTRA+=("-Dapksim.network=$2:$NET_FILE"); shift 3 ;;
    --network-profile) EXTRA+=("-Dapksim.networkProfile=$2"); shift 2 ;;
    --network-redact) EXTRA+=("-Dapksim.networkRedact=$2"); shift 2 ;;
    --network-match) EXTRA+=("-Dapksim.networkMatch=$2"); shift 2 ;;
    --network-ignore-query) EXTRA+=("-Dapksim.networkIgnoreQuery=$2"); shift 2 ;;
    --network-ignore-header) EXTRA+=("-Dapksim.networkIgnoreHeader=$2"); shift 2 ;;
    --network-unmatched) EXTRA+=("-Dapksim.networkUnmatched=$2"); shift 2 ;;
    --network-replay-timing) EXTRA+=("-Dapksim.networkReplayTiming=$2"); shift 2 ;;
    --network-host) NET_HOSTS="${NET_HOSTS:+$NET_HOSTS,}$2"; shift 2 ;;
    --network-trust)
      [[ -f "$2" ]] || { echo "no certificate at $2" >&2; exit 2; }
      EXTRA+=("-Dapksim.networkTrust=$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"); shift 2 ;;
    --no-sandbox) NO_SANDBOX=1; shift ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
done
[[ -n "${RECORD_MODE:-}" && -z "${RECORD_DIR:-}" ]] && { echo "--record needs --record-dir DIR" >&2; exit 2; }
[[ -n "${NET_HOSTS:-}" ]] && EXTRA+=("-Dapksim.networkHost=$NET_HOSTS")
[[ -n "${FEATURES:-}" ]] && EXTRA+=("-Dapksim.features=$FEATURES")
[[ -n "${SKIP_LIBS:-}" ]] && EXTRA+=("-Dapksim.skipLibraries=$SKIP_LIBS")
# A bundle's repro.sh repeats this launch: its arguments (unit separators between them), folder and launcher.
if [[ -n "${BUNDLES:-}" ]]; then
  IFS_SAVED="$IFS"; IFS=$'\x1f'; ARGV="${ORIG[*]}"; IFS="$IFS_SAVED"
  EXTRA+=("-Dapksim.argv=$ARGV" "-Dapksim.cwd=$PWD" "-Dapksim.launcherScript=$ROOT/apksim")
fi
# Always passed: a standby keeps the properties it booted with, and this launch's must replace them.
EXTRA+=("-Dapksim.window=${WINDOW_MODE:-${APKSIM_WINDOW:-front}}")
FLAGS="${NO_NET:+n}${NO_SANDBOX:+s}${APKSIM_NO_CORE:+k}"
# A standby takes only properties read after it takes the launch: the options above and a few switches. JVM options,
# a debugger, test runs, other -D switches (read while the standby boots) and training (APKSIM_NOCACHE) launch cold.
WARM_OK=""
if [[ "$OS" == Darwin && -x "$CLIENT" && -z "${APKSIM_NOCACHE:-}" && -z "${APKSIM_SANDBOX_TEST:-}" \
      && "${APKSIM_STANDBY:-1}" != 0 && -z "$STANDBY_SOCK" ]]; then
  WARM_OK=1
  for e in "${EXTRA[@]+"${EXTRA[@]}"}"; do
    case "$e" in
      -Dapksim.activity=*|-Dapksim.screenshot=*|-Dapksim.exitAfterFirstFrame=*|-Dapksim.control=*|-Dapksim.controlBind=*|-Dapksim.adb=*) ;;
      -Dapksim.device=*|-Dapksim.appearance=*|-Dapksim.locale=*|-Dapksim.timezone=*|-Dapksim.fontScale=*|-Dapksim.permissions=*|-Dapksim.clock=*) ;;
      -Dapksim.serial=*|-Dapksim.features=*|-Dapksim.skipLibraries=*|-Dapksim.moveSharedData=*|-Dapksim.build.*|-Dapksim.bluetooth=*|-Dapksim.setting.*) ;;
      -Dapksim.maxFps=*|-Dapksim.video=*|-Dapksim.audio=*|-Dapksim.animScale=*) ;;
      -Dapksim.biometricsEnrolled=*|-Dapksim.softKeyboard=*|-Dapksim.statusBar=*|-Dapksim.navBar=*|-Dapksim.windowX=*|-Dapksim.window=*|-Dapksim.headless=*|-Dapksim.fresh=*|-Dapksim.logcat=*|-Dapksim.noAutofill=*|-Dapksim.dataSlots=*) ;;
      -Dapksim.timing=*|-Dapksim.profile=*|-Dapksim.profile.*|-Dapksim.jfr=*|-Dapksim.quiet=*|-Dapksim.traceExit=*|-Dapksim.crashes=*|-Dapksim.crashTest.*|-Dapksim.providerFailures=*) ;;
      -Dapksim.classCache=*|-Dapksim.apkCacheMB=*|-Dapksim.loadAhead=*|-Dapksim.loadAheadThreads=*|-Dapksim.peephole=*|-Dapksim.vsync=*) ;;
      # Recording launches cold: its sandbox must let it write the recording's folder (a standby's is fixed).
      -Dapksim.network=replay:*|-Dapksim.networkProfile=*|-Dapksim.networkRedact=*|-Dapksim.networkMatch=*) ;;
      -Dapksim.networkIgnoreQuery=*|-Dapksim.networkIgnoreHeader=*|-Dapksim.networkUnmatched=*) ;;
      -Dapksim.networkReplayTiming=*|-Dapksim.networkHost=*|-Dapksim.networkTrust=*|-Dapksim.networkTrace=*) ;;
      *) WARM_OK="" ;;
    esac
  done
fi
if [[ "$OS" == Darwin ]]; then
  # The JDK scripts/build.sh compiled with (scripts/jdk.sh finds it), read with a builtin. A path relative to this
  # folder is setup's own work/jdk-24. If the recorded JDK is gone (moved or removed), fall back to work/jdk-24,
  # then Homebrew's openjdk.
  JAVA="${APKSIM_JAVA:-}"
  if [[ -z "$JAVA" ]]; then
    JDK_HOME=""; [[ -f "$ROOT/work/jdk.path" ]] && read -r JDK_HOME < "$ROOT/work/jdk.path" || true
    [[ -n "$JDK_HOME" && "$JDK_HOME" != /* ]] && JDK_HOME="$ROOT/$JDK_HOME"
    for JDK_HOME in "$JDK_HOME" "$ROOT/work/jdk-24/Contents/Home" /opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home; do
      [[ -n "$JDK_HOME" && -x "$JDK_HOME/bin/java" ]] && break
    done
    JAVA="$JDK_HOME/bin/java"
  fi
else
  JAVA="${APKSIM_JAVA:-${JAVA_HOME:+$JAVA_HOME/bin/}java}"
fi
if [[ -n "${SERVE:-}" ]]; then
  exec "$JAVA" -XX:+UseSerialGC -Xmx256m -XX:TieredStopAtLevel=1 -Dapksim.root="$ROOT" -Dapksim.state="$STATE" \
    -cp "$ROOT/work/apksim.jar" dev.apksim.serve.Serve "$@"
fi
# The JVM starts with LC_NUMERIC en_US.UTF-8. Robolectric's libandroid_runtime sets it when it loads
# (AndroidRuntime::onStarted, setlocale(LC_NUMERIC, "en_US.UTF-8")), on the main thread with the JIT compilers running.
# macOS's setlocale swaps the global locale's numeric part under any thread formatting a number or string:
# localeconv_l read it half replaced and a compiler thread crashed in vsnprintf (now and then, under load; even the
# crash report then deadlocked, so no hs_err). libjava already calls setlocale(LC_ALL, "") once while the VM is
# single-threaded; with the variable set it takes en_US.UTF-8 then, and the later call finds the same name and changes
# nothing. LC_ALL would override it, so it is split into the categories it stands for. Java's Locale does not follow
# LC_NUMERIC. Not on Linux: the image may have no en_US.UTF-8, and glibc fails a whole setlocale(LC_ALL, "") over one
# category it cannot load.
if [[ "$OS" == Darwin ]]; then
  if [[ -n "${LC_ALL:-}" ]]; then
    export LC_COLLATE="$LC_ALL" LC_CTYPE="$LC_ALL" LC_MESSAGES="$LC_ALL" LC_MONETARY="$LC_ALL" LC_TIME="$LC_ALL"
    unset LC_ALL
  fi
  export LC_NUMERIC=en_US.UTF-8
fi
# APKSIM_LOGCAT=1 sends the app's android.util.Log output to stderr from the start (or `logcat on` later).
[[ -n "${APKSIM_LOGCAT:-}" ]] && EXTRA+=("-Dapksim.logcat=true")
if [[ "$1" == /* ]]; then APK="$1"; else APK="$PWD/${1#./}"; fi
for i in "${!EXTRA[@]}"; do
  # Relative to this launch's directory, whatever the working directory of the JVM that takes it.
  [[ "${EXTRA[$i]}" == -Dapksim.screenshot=* && "${EXTRA[$i]#*=}" != /* ]] && EXTRA[$i]="-Dapksim.screenshot=$PWD/${EXTRA[$i]#*=}"
done
# The startup cache records file paths, so it fits only the install it was built for (app.aot.root). An installed
# release builds it in the background on its first launch, and after an upgrade (a new folder); this launch goes ahead
# without it. A source checkout builds it with scripts/train.sh.
AOT_ROOT=""
if [[ -z "${APKSIM_NOCACHE:-}" && -f "$STATE/app.aot" ]]; then { read -r AOT_ROOT < "$STATE/app.aot.root"; } 2>/dev/null || true; fi
# (Not again when the client hands a launch back for a cold start: APKSIM_STANDBY=cold.)
if [[ "$AOT_ROOT" != "$ROOT" && -f "$ROOT/work/release" && "$OS" == Darwin && -z "${APKSIM_NOCACHE:-}" && -z "$STANDBY_SOCK" \
      && "${APKSIM_STANDBY:-}" != cold ]]; then
  TRAIN_PID=""; { read -r TRAIN_PID < "$STATE/train.pid"; } 2>/dev/null || true
  if [[ -z "$TRAIN_PID" ]] || ! kill -0 "$TRAIN_PID" 2>/dev/null; then
    mkdir -p "$STATE"
    echo "[apksim] building the startup cache in the background (once, 1-2 minutes); launches are faster after that" >&2
    "$CLIENT" detach "$STATE/train.log" "$ROOT/scripts/train.sh" --headless
  fi
fi
if [[ -n "$WARM_OK" && "${APKSIM_STANDBY:-}" != cold ]]; then
  exec "$CLIENT" launch "$ROOT/apksim" "$KEY" "$FLAGS" -- "${EXTRA[@]+"${EXTRA[@]}"}" "$APK" -- "${ORIG[@]}"
fi
# macOS's date has no milliseconds; there Timing takes this process's start time instead (exec keeps the PID), which
# spares starting python3 just to read the clock.
[[ "$OS" == Darwin ]] || export APKSIM_T0=${APKSIM_T0:-$(date +%s%3N)}
# This launch may start the next standby (Standby.spawnNext), which inherits its sandbox.
[[ -n "$WARM_OK" ]] && EXTRA+=("-Dapksim.spawnStandby=$FLAGS")
[[ -n "$STANDBY_SOCK" ]] && EXTRA+=("-Dapksim.standby=$STANDBY_SOCK" "-Dapksim.spawnStandby=$FLAGS")
# Robolectric mishandles spaces in its dependency path, so always go through a link without any.
TMP="${TMPDIR:-/tmp}"
LIBS="${TMP%/}/apksim-$(printf '%s' "$ROOT" | { shasum 2>/dev/null || sha1sum; } | cut -c1-12)"
[[ -e "$LIBS" ]] || ln -sfn "$ROOT/work/lib" "$LIBS"
CP="$ROOT/work/apksim.jar:$(ls "$LIBS"/ | sed "s#^#$LIBS/#" | grep "\.jar$" | grep -v nativeruntime-dist | tr '\n' ':')"
# `exec` keeps this PID, which is how a later launch knows whether this scratch dir is still in use.
mkdir -p "$STATE/tmp/$$"
# An APK runs as ordinary code in this process, with no VM around it, so confine it: it can only
# write under its state folder (work/ or ~/.apksim) and temp, and cannot read credentials. Network stays on unless --no-network.
SANDBOX=()
# A standby started by a sandboxed instance is already inside the same sandbox (FLAGS are part of its name).
if [[ "$OS" == Darwin && -z "${NO_SANDBOX:-}" && -z "${APKSIM_NOCACHE:-}" && -z "${APKSIM_SANDBOXED:-}" ]]; then
  export APKSIM_SANDBOXED=1
  PROFILE="(version 1)(allow default)
(deny file-write* (subpath \"$HOME\"))
(allow file-write* (subpath \"$STATE\"))${BUNDLES:+
(allow file-write* (subpath \"$BUNDLES\"))}${RECORD_DIR:+
(allow file-write* (subpath \"$RECORD_DIR\"))}${NET_RECORD_FILE:+
(allow file-write* (literal \"$NET_RECORD_FILE\") (literal \"$NET_RECORD_FILE.apksim-tmp\"))}${TEST_OUTPUTS:+
(allow file-write* (subpath \"$TEST_OUTPUTS\"))}
(deny file-read* (subpath \"$HOME/.ssh\") (subpath \"$HOME/.aws\") (subpath \"$HOME/.gnupg\") (subpath \"$HOME/.config\")
  (subpath \"$HOME/Library/Keychains\") (subpath \"$HOME/Library/Cookies\") (subpath \"$HOME/Documents\") (subpath \"$HOME/Desktop\")
  (subpath \"$HOME/Library/Application Support/Google\") (subpath \"$HOME/Library/Application Support/Firefox\"))"
  if [[ -n "${NO_NET:-}" ]]; then
    PROFILE="$PROFILE
(deny network-outbound (remote ip))
(allow network-outbound (remote ip \"localhost:*\"))"
  fi
  SANDBOX=(sandbox-exec -p "$PROFILE")
fi
# The JDK reaches 127.0.0.1 as ::ffff:127.0.0.1 on a dual-stack socket, which the rule above cannot allow, so under
# --no-network libloopback moves those connects to IPv4 sockets. Set through env: dyld drops DYLD_* variables when
# it starts sandbox-exec (a system binary), and so would not pass them on. A standby's instance inherits it.
ENVP=()
if [[ "$OS" == Darwin && -n "${NO_NET:-}" && -z "${NO_SANDBOX:-}" && -f "$ROOT/work/runtime/libloopback.dylib" ]]; then
  ENVP=(/usr/bin/env "DYLD_INSERT_LIBRARIES=$ROOT/work/runtime/libloopback.dylib")
fi
if [[ "$OS" != Darwin && -n "${NO_NET:-}" ]]; then
  echo "[apksim] --no-network is macOS-only; in a container use docker run --network none" >&2
fi
if [[ -n "${APKSIM_SANDBOX_TEST:-}" ]]; then exec "${SANDBOX[@]+"${SANDBOX[@]}"}" "${ENVP[@]+"${ENVP[@]}"}" /bin/sh -c "$APKSIM_SANDBOX_TEST"; fi
# A test run's JIT stops at C1: C2's compiles cost more CPU than a test process gets back from them. Measured on a large
# app's 4,134 device tests: the same wall time or less and ~40% less CPU on the Mac; on 4 CPUs in the Linux image,
# three suites at once took 135 s against 312 s, and a third of the CPU. `--jvm -XX:TieredStopAtLevel=4` (after this) brings C2 back.
JIT=()
[[ -n "${TEST_RUN:-}" ]] && JIT=(-XX:TieredStopAtLevel=1)
AOT=()
if [[ "$AOT_ROOT" == "$ROOT" ]]; then
  AOT=("-XX:AOTCache=$STATE/app.aot")
elif [[ -n "$AOT_ROOT" && ! -f "$ROOT/work/release" ]]; then
  echo "[apksim] the startup cache was built in another folder; run scripts/train.sh once for faster launches" >&2
fi
# A small young generation keeps GC pauses inside a frame: fewer objects live long enough to be copied
# (64 MB: ~1 ms median pause while scrolling; 256 MB: ~12 ms, up to 50 ms). It also saves ~150 MB.
# apksim serve sets APKSIM_NO_CORE: a crashed instance (a large app is gigabytes) writes its hs_err report but no core file.
NOCORE=()
# The core-size limit too: a native abort (libc abort() from an app's library) never reaches HotSpot's crash handling.
if [[ -n "${APKSIM_NO_CORE:-}" ]]; then NOCORE=(-XX:-CreateCoredumpOnCrash); ulimit -c 0 2>/dev/null || true; fi
exec "${SANDBOX[@]+"${SANDBOX[@]}"}" "${ENVP[@]+"${ENVP[@]}"}" "$JAVA" "${NOCORE[@]+"${NOCORE[@]}"}" \
  -XX:+UnlockDiagnosticVMOptions -XX:+UseSerialGC -Xmn64m -Xms512m -XX:MetaspaceSize=256m -XX:-BytecodeVerificationRemote -Xss4m \
  --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED \
  --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.net=ALL-UNNAMED \
  --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED \
  --add-exports=java.base/jdk.internal.access=ALL-UNNAMED --add-opens=java.base/jdk.internal.access=ALL-UNNAMED \
  --add-opens=java.base/jdk.internal.loader=ALL-UNNAMED --add-opens=java.base/sun.nio.ch=ALL-UNNAMED \
  --enable-native-access=ALL-UNNAMED \
  -Drobolectric.offline=true -Drobolectric.dependency.dir="$LIBS" -Drobolectric.enabledSdks=36 -Drobolectric.pixelCopyRenderMode=hardware \
  -Djava.io.tmpdir="$STATE/tmp/$$" -Dapksim.root="$ROOT" -Dapksim.cacheRoot="$STATE/cache" -Dapksim.runtime="$ROOT/work/runtime" "${AOT[@]+"${AOT[@]}"}" "${JIT[@]+"${JIT[@]}"}" \
  "${EXTRA[@]+"${EXTRA[@]}"}" \
  -cp "$CP" dev.apksim.Main "$APK"
