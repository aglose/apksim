#!/bin/bash
# Changes reach main only through pull requests (see "Git and pull requests" in AGENTS.md): refuse a direct push to
# it. Every commit being pushed is also checked for personal information (scripts/hooks/check-private): its message,
# author and committer, and its changes, and so is the branch or tag name. Installed by scripts/setup.sh
# (git config core.hooksPath scripts/hooks). Bypass once with --no-verify.
remote="$1"
zero=0000000000000000000000000000000000000000
status=0
# What the remote really has (remote-tracking refs can be stale, e.g. after its history was rewritten), as far as
# those commits exist here.
have=""
for sha in $(git ls-remote "$remote" 'refs/heads/*' 'refs/tags/*' 2>/dev/null | cut -f1 | sort -u); do
  git cat-file -e "$sha^{commit}" 2>/dev/null && have="$have ^$sha"
done
while read -r _local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == refs/heads/main ]]; then
    echo "pre-push: main takes changes through pull requests. Push a branch and run: gh pr create" >&2
    exit 1
  fi
  [[ "$local_sha" == "$zero" ]] && continue  # deleting a branch
  printf '%s\n' "$remote_ref" | "$(dirname "$0")/check-private" --text "the name of the pushed branch or tag" || status=1
  # The commits the remote does not have yet. Its branches alone, not stale local refs, say what it has.
  # shellcheck disable=SC2086
  "$(dirname "$0")/check-private" --commits "$local_sha$have" || status=1
done
exit $status
