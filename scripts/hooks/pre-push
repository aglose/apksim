#!/bin/bash
# Changes reach main only through pull requests (see "Git and pull requests" in AGENTS.md): refuse a direct push to
# it. Every commit being pushed is also checked for personal information (scripts/hooks/check-private): its message,
# author and committer, and its changes. Installed by scripts/setup.sh (git config core.hooksPath scripts/hooks).
# Bypass once with --no-verify.
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == refs/heads/main ]]; then
    echo "pre-push: main takes changes through pull requests. Push a branch and run: gh pr create" >&2
    exit 1
  fi
  [[ "$local_sha" == "$zero" ]] && continue  # deleting a branch
  if [[ "$remote_sha" == "$zero" ]]; then
    range="$local_sha --not --remotes"       # a new branch: the commits no remote has yet
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086
  "$(dirname "$0")/check-private" --commits "$range" || status=1
done
exit $status
